{
  "name": "mcp-node-turismo",
  "version": "1.0.0",
  "description": "Servidor Model Context Protocol (MCP) en Node.js para la API de Turismo de Tucumán",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "turismo-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
